# Settings for the SAR matrix service. Copy to .env for a local test only;
# in AWS supply these from Secrets Manager / the task definition, never a file
# in the image or the repository.

# CDD Vault id (a number) and API token. Secret: inject from AWS Secrets Manager.
cddVaultId=
cddAPIToken=

# Directory the downloaded CDD copy is written to; mount persistent storage here.
SAR_DATA_DIR=/data
